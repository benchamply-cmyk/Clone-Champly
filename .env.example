# Clé API Claude (console.anthropic.com). Ne jamais la committer.
ANTHROPIC_API_KEY=

# Jeton secret pour appeler l'API de l'assistant (en-tête Authorization: Bearer ...).
# Générer par exemple avec : openssl rand -hex 32
ASSISTANT_TOKEN=

# Modèles : cerveau (raisonnement) et rapide (tri, résumés de fond)
MODEL_MAIN=claude-opus-5-5
MODEL_FAST=claude-haiku-5-5
# Niveau d'effort du chef de cabinet : low | medium | high | xhigh | max
EFFORT_MAIN=high

PORT=3000
# Dossier où la mémoire est stockée (fichier JSON en attendant PostgreSQL)
DATA_DIR=./data
